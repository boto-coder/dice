{
  "name": "dice-roller",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "3D physics dice roller for tabletop RPGs and board games",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:fairness && npm run test:e2e",
    "test:unit": "vitest run --coverage --exclude 'tests/fairness/**'",
    "test:fairness": "vitest run tests/fairness --coverage.enabled=false",
    "test:firefox": "ALL_BROWSERS=1 playwright test --project=desktop-firefox",
    "test:watch": "vitest --exclude 'tests/fairness/**'",
    "test:e2e": "playwright test",
    "fairness": "FAIRNESS_REPORT=1 vitest run tests/fairness/report.test.ts --coverage.enabled=false && prettier --write docs/fairness-report.md",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.187.0"
  }
}
